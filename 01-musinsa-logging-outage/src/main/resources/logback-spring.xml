<?xml version="1.0" encoding="UTF-8"?>
<!--
	Spring Boot 기본 콘솔 설정(defaults.xml + console-appender.xml)과 똑같이 출력하고, 3단계 스위치만 더했다.
	스위치를 켜지 않으면 1·2단계와 같은 동기 ConsoleAppender다. 스위치는 SPRING_PROFILES_ACTIVE로 켠다.
		trace               로그에 trace_id, span_id를 넣는다. 로그를 문자열로 만드는 순간 Span.current()에서 읽는다 (원문의 표준 로깅 라이브러리 방식)
		trace,async         위 설정에서 출력만 기본 AsyncAppender로 (3-B)
		trace,trace-aware   위 설정에서 출력만 원문의 TraceAwareAsyncAppender로 (3-C)
-->
<configuration>
	<conversionRule conversionWord="otelTraceId" class="replay.loggingoutage.logging.OtelTraceIdConverter"/>
	<conversionRule conversionWord="otelSpanId" class="replay.loggingoutage.logging.OtelSpanIdConverter"/>

	<springProfile name="trace">
		<!-- Spring Boot 기본 패턴에서 스레드 이름 뒤에 trace_id, span_id만 끼워 넣었다. defaults.xml보다 먼저 정해야 적용된다 -->
		<property name="CONSOLE_LOG_PATTERN" value="%clr(%d{${LOG_DATEFORMAT_PATTERN:-yyyy-MM-dd'T'HH:mm:ss.SSSXXX}}){faint} %clr(${LOG_LEVEL_PATTERN:-%5p}){} %clr(${PID:-}){magenta} %clr(--- %esb(){APPLICATION_NAME}%esb{APPLICATION_GROUP}[%15.15t]){faint} [trace_id=%otelTraceId span_id=%otelSpanId] %clr(%-40.40logger{39}){cyan} %clr(:){faint} %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>
	</springProfile>

	<include resource="org/springframework/boot/logging/logback/defaults.xml"/>

	<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
		<filter class="ch.qos.logback.classic.filter.ThresholdFilter">
			<level>${CONSOLE_LOG_THRESHOLD}</level>
		</filter>
		<encoder>
			<pattern>${CONSOLE_LOG_PATTERN}</pattern>
			<charset>${CONSOLE_LOG_CHARSET}</charset>
		</encoder>
	</appender>

	<springProfile name="async">
		<!-- Logback 기본값 그대로: 큐 256칸, 큐가 80% 차면 INFO 이하를 버림, 큐가 가득 차면 호출 스레드를 막음 -->
		<appender name="ASYNC" class="ch.qos.logback.classic.AsyncAppender">
			<appender-ref ref="CONSOLE"/>
		</appender>
		<root level="INFO">
			<appender-ref ref="ASYNC"/>
		</root>
	</springProfile>
	<springProfile name="trace-aware">
		<!-- 원문처럼 큐가 가득 차면 기다리지 않고 버린다(neverBlock=true). 나머지는 Logback 기본값 -->
		<appender name="TRACE_AWARE" class="replay.loggingoutage.logging.TraceAwareAsyncAppender">
			<neverBlock>true</neverBlock>
			<appender-ref ref="CONSOLE"/>
		</appender>
		<root level="INFO">
			<appender-ref ref="TRACE_AWARE"/>
		</root>
	</springProfile>
	<springProfile name="!async &amp; !trace-aware">
		<root level="INFO">
			<appender-ref ref="CONSOLE"/>
		</root>
	</springProfile>
</configuration>
